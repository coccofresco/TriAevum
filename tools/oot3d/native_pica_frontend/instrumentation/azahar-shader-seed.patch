+void WriteSeedProgram(State& state, ShaderSetup& setup) {
+    setup.DoProgramCodeFixup();
+    const auto key = std::tuple{setup.GetProgramCodeHash(), setup.GetSwizzleDataHash(),
+                               setup.GetBiggestProgramSize(), setup.GetBiggestSwizzleSize()};
+    if (!state.seed_programs.insert(key).second) return;
+    Event(state, "shader_seed_program") << ",\"program_hash\":";
+    WriteHex(state.out, setup.GetProgramCodeHash(), 16);
+    state.out << ",\"swizzle_hash\":";
+    WriteHex(state.out, setup.GetSwizzleDataHash(), 16);
+    state.out << ",\"program\":[";
+    for (u32 i = 0; i < setup.GetBiggestProgramSize(); ++i) {
+        if (i) state.out << ',';
+        WriteHex(state.out, setup.GetProgramCode()[i]);
+    }
+    state.out << "],\"swizzles\":[";
+    for (u32 i = 0; i < setup.GetBiggestSwizzleSize(); ++i) {
+        if (i) state.out << ',';
+        WriteHex(state.out, setup.GetSwizzleData()[i]);
+    }
+    state.out << "]}\n";
+}
+
+// Each frame is self-contained; unchanged resources are emitted only once.
+// These are preparation inputs, not a replacement for live game resource state.
+void WriteSeedLuts(State& state, const PicaCore& core) {
+    std::vector<u32> words;
+    words.reserve(24 * 256 + 128 * 4 + 256 * 2);
+    const auto append = [&](const auto& table) {
+        for (const auto& entry : table) words.push_back(entry.raw);
+    };
+    for (const auto& table : core.lighting.luts) append(table);
+    append(core.proctex.noise_table);
+    append(core.proctex.color_map_table);
+    append(core.proctex.alpha_map_table);
+    append(core.proctex.color_table);
+    append(core.proctex.color_diff_table);
+    append(core.fog.lut);
+    if (words == state.seed_luts) return;
+    state.seed_luts = std::move(words);
+    Event(state, "shader_seed_luts") << ",\"format\":\"pica_lut_words_v1\",\"words\":[";
+    for (size_t i = 0; i < state.seed_luts.size(); ++i) {
+        if (i) state.out << ',';
+        WriteHex(state.out, state.seed_luts[i]);
+    }
+    state.out << "]}\n";
+}
