[Desktop Entry]
Type=Application
Name=TriAevum — Moonfall Curse
Comment=Prepare your personal Majora’s Mask 3D dump with Forge and play Moonfall Curse
Exec=triaevum
Icon=io.github.coccofresco.TriAevum.MM3D
Terminal=false
Categories=Game;
Actions=Play;Forge;

[Desktop Action Play]
Name=Play
Exec=triaevum

[Desktop Action Forge]
Name=Prepare or repair game
Exec=triaevum --forge
Icon=io.github.coccofresco.TriAevum.MM3D.Forge
