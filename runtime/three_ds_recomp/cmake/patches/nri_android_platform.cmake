if(NOT NRI_SOURCE_DIR)
    message(FATAL_ERROR "NRI_SOURCE_DIR is required")
endif()
set(path "${NRI_SOURCE_DIR}/CMakeLists.txt")
file(READ "${path}" source)
set(old "if(NOT (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL \"Linux\" OR APPLE))")
set(new "if(NOT (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL \"Linux\" OR APPLE OR ANDROID))")
string(FIND "${source}" "${new}" patched)
if(NOT patched EQUAL -1)
    return()
endif()
string(FIND "${source}" "${old}" location)
if(location EQUAL -1)
    message(FATAL_ERROR "Pinned NRI platform check changed; review the Android patch")
endif()
string(REPLACE "${old}" "${new}" source "${source}")
file(WRITE "${path}" "${source}")
