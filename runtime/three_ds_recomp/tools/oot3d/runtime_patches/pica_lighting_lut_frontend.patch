diff --git a/tools/oot3d/native_pica_frontend/oot3d_native_pica_frontend_tests.cpp b/tools/oot3d/native_pica_frontend/oot3d_native_pica_frontend_tests.cpp
index 4a8bb9c36..be52ffb38 100644
--- a/tools/oot3d/native_pica_frontend/oot3d_native_pica_frontend_tests.cpp
+++ b/tools/oot3d/native_pica_frontend/oot3d_native_pica_frontend_tests.cpp
@@ -369,0 +370,40 @@ int main() {
+
+    Oot3dNativeGame::Oot3dNativePicaFrontend lightingLutFrontend;
+    Oot3dNativeGame::Oot3dGspCommandPacket lightingLutUpload{};
+    lightingLutUpload.Control = 1;
+    lightingLutUpload.Parameters[0] = 0x14004200U;
+    constexpr uint32_t lightingLutValue0 = 0x00123456U;
+    constexpr uint32_t lightingLutValue1 = 0x00ABCDEFU;
+    constexpr std::array<uint32_t, 5> lightingLutUploadCommands{
+        (16U << 8U) | 255U, 0x000F01C5U, lightingLutValue0,
+        0x801F01C8U, lightingLutValue1};
+    lightingLutUpload.Parameters[1] = static_cast<uint32_t>(
+        lightingLutUploadCommands.size() * sizeof(uint32_t));
+    Require(lightingLutFrontend.SubmitGspCommand(
+                lightingLutUpload, lightingLutUploadCommands, &error),
+            error);
+    Oot3dNativeGame::Oot3dGspCommandPacket lightingLutDraw{};
+    lightingLutDraw.Control = 1;
+    lightingLutDraw.Parameters[0] = 0x14004300U;
+    lightingLutDraw.Parameters[1] = 8U;
+    Require(lightingLutFrontend.SubmitGspCommand(
+                lightingLutDraw, fogDrawCommands, &error),
+            error);
+    const auto& lightingLutPacket =
+        lightingLutFrontend.PendingDrawPackets().back();
+    Require(lightingLutFrontend.ReadPicaRegister(0x1C5U) ==
+                ((16U << 8U) | 1U) &&
+                lightingLutPacket.LightingLuts != nullptr &&
+                (*lightingLutPacket.LightingLuts)[16][255] ==
+                    lightingLutValue0 &&
+                (*lightingLutPacket.LightingLuts)[16][0] ==
+                    lightingLutValue1,
+            "PICA lighting LUT upload did not preserve table and wrapped index");
+
+    const auto lightingLutState = lightingLutFrontend.CaptureState();
+    Oot3dNativeGame::Oot3dNativePicaFrontend restoredLightingLutFrontend;
+    Require(restoredLightingLutFrontend.RestoreState(lightingLutState, &error),
+            error);
+    Require(restoredLightingLutFrontend.CaptureState().at("lighting_luts") ==
+                lightingLutState.at("lighting_luts"),
+            "PICA lighting LUT state did not survive a savestate round-trip");
