@@ -34,0 +35,3 @@ constexpr uint16_t kPicaFogLutDataEnd = 0x0EFU;
+constexpr uint16_t kPicaLightingLutIndex = 0x1C5U;
+constexpr uint16_t kPicaLightingLutDataBegin = 0x1C8U;
+constexpr uint16_t kPicaLightingLutDataEnd = 0x1CFU;
@@ -247,0 +251,19 @@ void Oot3dNativePicaFrontend::ApplyShaderRegisterSideEffects(
+    if (registerId >= kPicaLightingLutDataBegin &&
+        registerId <= kPicaLightingLutDataEnd) {
+        const uint32_t cursor = mPicaRegisters[kPicaLightingLutIndex];
+        const size_t table = (cursor >> 8U) & 0x1FU;
+        const size_t index = cursor & 0xFFU;
+        const bool validTable = table == 0U || table == 1U || table == 3U ||
+                                (table >= 4U && table <= 6U) ||
+                                (table >= 8U && table <= 23U);
+        if (validTable) {
+            if (mLightingLuts.use_count() != 1) {
+                mLightingLuts =
+                    std::make_shared<Oot3dPicaLightingLutState>(*mLightingLuts);
+            }
+            (*mLightingLuts)[table][index] = writeValue & 0xFFFFFFU;
+        }
+        mPicaRegisters[kPicaLightingLutIndex] =
+            (cursor & 0xFFFFFF00U) | ((index + 1U) & 0xFFU);
+        return;
+    }
