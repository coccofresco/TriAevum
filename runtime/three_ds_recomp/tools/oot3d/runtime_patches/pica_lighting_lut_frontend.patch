+             format != "oot3d_native_pica_frontend_state_v2")) {
@@ -667,0 +692,5 @@ bool Oot3dNativePicaFrontend::RestoreState(const nlohmann::json& state,
+        mLightingLuts = format == "oot3d_native_pica_frontend_state_v2"
