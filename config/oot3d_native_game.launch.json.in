{
  "format": "oot3d_native_game_launch_profile_v1",
  "variables": {
    "source_root": "@CMAKE_CURRENT_SOURCE_DIR@",
    "workspace_root": "@OOT3D_NATIVE_GAME_WORKSPACE_ROOT@"
  },
  "arguments": [
    "--manifest",
    "${workspace_root}/standalone_demo/kokiri_forest/demo_manifest.json",
    "--resource-root",
    "${source_root}/runtime/three_ds_recomp/src/fast",
    "--asset-catalog",
    "${workspace_root}/playable_catalog/oot3d_asset_catalog.json",
    "--playable-pack",
    "${workspace_root}/playable_pack/oot3d_playable_pack.json",
    "--route-catalog",
    "${workspace_root}/playable_catalog/oot3d_semantic_route_catalog.json",
    "--player-animation-contract",
    "${source_root}/tools/oot3d/decomp_support/analysis/player_animation_group_native_contract.json",
    "--player-runtime-semantics",
    "${source_root}/tools/oot3d/oot3d_asset_tool/profiles/link_child_native_runtime_semantics.json",
    "--player-collision-action-contract",
    "${source_root}/tools/oot3d/decomp_support/analysis/player_collision_action_native_contract.json",
    "--actor-core-contract",
    "${source_root}/tools/oot3d/decomp_support/analysis/actor_core_native_contract.json",
    "--actor-shard",
    "${workspace_root}/playable_actors/oot3d-actors-native.o2r",
    "--room-compilation-unit",
    "${workspace_root}/room_compilation_units/scene_entry_SCENE_ENTRY_KOKIRI_FOREST_FROM_LINKS_HOUSE_KOKIRI_FOREST_INITIAL_CHILD_DAY.json",
    "--native-closure-manifest",
    "${workspace_root}/native_corpus/kokiri_initial_607aaa6/manifest.json",
    "--a32-process-manifest",
    "${profile_dir}/oot3d_native_process_manifest.json",
    "--route-id",
    "scene_entry:SCENE_ENTRY_KOKIRI_FOREST_FROM_LINKS_HOUSE:KOKIRI_FOREST_INITIAL_CHILD_DAY",
    "--renderer",
    "nri",
    "--ui-profile",
    "topscreen",
    "--config",
    "${profile_dir}/oot3d_native_game.json",
    "--topscreen-texture-overrides",
    "${source_root}/tools/oot3d/ui_topscreen/assets/atlas_overrides.o3tu",
    "--topscreen-config",
    "${source_root}/config/topscreen_ui.example.json",
    "--pica-aot-shader-pack",
    "${profile_dir}/oot3d_pica_default.o3ps",
    "--gameplay-timing",
    "native30_interpolated",
    "--presentation-rate",
    "60",
    "--output",
    "${workspace_root}/native_game/kokiri_native_game.json",
    "--save-data",
    "${workspace_root}/native_game/oot3d_native_savedata",
    "--width",
    "1280",
    "--height",
    "720"
  ]
}
